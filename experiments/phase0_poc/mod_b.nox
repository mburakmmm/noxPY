class Box:
    val: int

    def __init__(self, v: int) -> None:
        self.val = v


@export
def mul(a: int, b: int) -> int:
    return a * b


@export
def sub(a: int, b: int) -> int:
    return a - b


@export
def box_new(v: int) -> Box:
    return Box(v)


@export
def box_get(b: Box) -> int:
    return b.val
