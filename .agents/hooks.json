{
  "noxpy-rtk-strict": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "sh ../scripts/hooks/session_rules.sh --agent antigravity",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/hooks/rtk_strict_guard.py --agent antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/hooks/token_audit_hook.py --agent antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
