# Deterministic PEP 561 .pyi type stub emitter in genuine Nox (AGENTS.md §7).

import nox.strings
from src.codegen.ir import ExportedFunctionIR, ModuleIR, ParamIR

__all__: list[str] = ["format_pyi_params", "generate_pyi"]


def format_pyi_params(fn: ExportedFunctionIR) -> str:
    """Format positional-only, positional-or-keyword, and keyword-only parameters."""
    pos_only: list[ParamIR] = []
    pos_or_kw: list[ParamIR] = []
    kw_only: list[ParamIR] = []

    for p in fn.params:
        if p.kind == "positional_only":
            pos_only.append(p)
        elif p.kind == "positional_or_keyword":
            pos_or_kw.append(p)
        else:
            kw_only.append(p)

    parts: list[str] = []
    for p in pos_only:
        parts.append(p.name + ": " + p.type_name)
    if len(pos_only) > 0:
        parts.append("/")
    for p in pos_or_kw:
        parts.append(p.name + ": " + p.type_name)
    if len(kw_only) > 0:
        parts.append("*")
        for p in kw_only:
            parts.append(p.name + ": " + p.type_name)
    return nox.strings.join(parts, ", ")


def generate_pyi(ir: ModuleIR) -> str:
    """Emit deterministic PEP 561 .pyi stub matching python/noxpy/codegen.py byte-for-byte."""
    lines: list[str] = [
        "# Generated by noxpy from " + ir.source + " (noxc " + ir.compiler_version + "). Do not hand-edit.",
        "",
    ]
    for fn in ir.functions:
        sig: str = "def " + fn.name + "(" + format_pyi_params(fn) + ") -> " + fn.return_type + ":"
        if fn.has_doc and fn.doc != "":
            escaped_doc: str = nox.strings.replace(fn.doc, '"""', '\\"\\"\\"')
            lines.append(sig)
            lines.append('    """' + escaped_doc + '"""')
            lines.append("    ...")
        else:
            lines.append(sig + " ...")
    lines.append("")
    return nox.strings.join(lines, "\n")
