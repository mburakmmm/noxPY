class Counter:
    value: int

    def __init__(self, start: int) -> None:
        self.value = start


@export
def add(a: int, b: int) -> int:
    return a + b


@export
def fib(n: int) -> int:
    if n < 0:
        raise ValueError("negative fibonacci index")
    if n <= 1:
        return n
    a: int = 0
    b: int = 1
    i: int = 2
    while i <= n:
        nxt: int = a + b
        a = b
        b = nxt
        i = i + 1
    return b


@export
def work_loop(iters: int, seed: int) -> int:
    acc: int = seed
    i: int = 0
    while i < iters:
        acc = (acc * 1103515245 + 12345 + i) % 2147483647
        i = i + 1
    return acc


@export
def checked_div(a: int, b: int) -> int:
    if b == 0:
        raise ValueError("division by zero")
    return a // b


@export
def alloc_checksum(n: int) -> int:
    if n < 0:
        raise ValueError("negative length")
    xs: list[int] = []
    i: int = 0
    while i < n:
        xs.append(i)
        i = i + 1
    total: int = 0
    for x in xs:
        total = total + x
    return total


@export
def echo_str(s: str) -> str:
    return s


@export
def echo_bytes(raw: bytes) -> bytes:
    return raw


@export
def counter_new(start: int) -> Counter:
    return Counter(start)


@export
def counter_inc(c: Counter, delta: int) -> int:
    c.value = c.value + delta
    return c.value
