# Structured diagnostic errors for NoxPy (AGENTS.md §11).

import nox.json
from nox.json import JsonWriter

__all__: list[str] = ["NoxPyError", "make_error"]


class NoxPyError(Exception):
    """Structured NoxPy diagnostic error with stable NPY-E-* code."""

    code: str
    file: str
    loc_line: int
    column: int
    hint: str

    def __init__(self, code: str, message: str, file: str, loc_line: int, column: int, hint: str) -> None:
        super().__init__(message)
        self.code = code
        self.file = file
        self.loc_line = loc_line
        self.column = column
        self.hint = hint

    def format_human(self) -> str:
        """Render diagnostic in human-readable CLI format."""
        loc: str = ""
        if self.file != "":
            if self.loc_line > 0:
                col: int = self.column if self.column > 0 else 1
                loc = self.file + ":" + str(self.loc_line) + ":" + str(col) + ": "
            else:
                loc = self.file + ": "
        out: str = "[" + self.code + "] " + loc + self.message
        if self.hint != "":
            out = out + "\n  hint: " + self.hint
        return out

    def to_json(self) -> str:
        """Serialize diagnostic to compact JSON."""
        w: JsonWriter = JsonWriter()
        w.begin_object()
        w.write_key("code")
        w.write_string(self.code)
        w.write_key("message")
        w.write_string(self.message)
        if self.file != "":
            w.write_key("location")
            w.begin_object()
            w.write_key("file")
            w.write_string(self.file)
            if self.loc_line > 0:
                w.write_key("line")
                w.write_int(self.loc_line)
            if self.column > 0:
                w.write_key("column")
                w.write_int(self.column)
            w.end_object()
        if self.hint != "":
            w.write_key("hint")
            w.write_string(self.hint)
        w.end_object()
        return w.build()


def make_error(code: str, message: str, file: str, line: int, column: int, hint: str) -> NoxPyError:
    """Construct a NoxPyError instance with explicit location metadata."""
    return NoxPyError(code, message, file, line, column, hint)
