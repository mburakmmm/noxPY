# Deterministic Binding Intermediate Representation (IR) in genuine Nox (AGENTS.md §7, UR-007).

import nox.json
import nox.strings
from nox.json import JsonError, JsonWriter
from src.core.errors import NoxPyError, make_error

__all__: list[str] = [
    "SourceSpan",
    "ParamIR",
    "ExportedFunctionIR",
    "ModuleIR",
    "is_valid_ident",
    "is_reserved_export_name",
    "is_c_keyword",
    "is_phase1_param_type",
    "is_phase1_return_type",
    "is_supported_param_type",
    "is_supported_return_type",
    "marshal_for_type",
    "is_valid_param_kind",
    "is_valid_thread_policy",
    "parse_upstream_metadata_json",
    "module_ir_to_json",
]

IR_SCHEMA_VERSION: int = 1
MAX_TYPE_NEST_DEPTH: int = 16


class SourceSpan:
    """Source file/line/column location for an exported Nox item."""

    file: str
    line: int
    column: int

    def __init__(self, file: str, line: int, column: int) -> None:
        self.file = file
        self.line = line
        self.column = column


class ParamIR:
    """Validated parameter signature descriptor in Binding IR."""

    name: str
    type_name: str
    marshal: str
    kind: str
    has_default: bool
    default_type: str
    default_int: int
    default_float: float
    default_bool: bool
    default_str: str

    def __init__(
        self,
        name: str,
        type_name: str,
        marshal: str,
        kind: str,
        has_default: bool,
        default_type: str,
        default_int: int,
        default_float: float,
        default_bool: bool,
        default_str: str,
    ) -> None:
        self.name = name
        self.type_name = type_name
        self.marshal = marshal
        self.kind = kind
        self.has_default = has_default
        self.default_type = default_type
        self.default_int = default_int
        self.default_float = default_float
        self.default_bool = default_bool
        self.default_str = default_str


class ExportedFunctionIR:
    """Validated exported function entry in Binding IR."""

    export_id: str
    name: str
    c_symbol: str
    params: list[ParamIR]
    return_type: str
    return_marshal: str
    doc: str
    has_doc: bool
    thread_policy: str
    span: SourceSpan

    def __init__(
        self,
        export_id: str,
        name: str,
        c_symbol: str,
        params: list[ParamIR],
        return_type: str,
        return_marshal: str,
        doc: str,
        has_doc: bool,
        thread_policy: str,
        span: SourceSpan,
    ) -> None:
        self.export_id = export_id
        self.name = name
        self.c_symbol = c_symbol
        self.params = params
        self.return_type = return_type
        self.return_marshal = return_marshal
        self.doc = doc
        self.has_doc = has_doc
        self.thread_policy = thread_policy
        self.span = span


class ModuleIR:
    """Validated module-level Binding IR container."""

    schema_version: int
    compiler_name: str
    compiler_version: str
    compiler_commit: str
    module_name: str
    leaf_name: str
    source: str
    abi: str
    free_threaded: bool
    functions: list[ExportedFunctionIR]

    def __init__(
        self,
        schema_version: int,
        compiler_name: str,
        compiler_version: str,
        compiler_commit: str,
        module_name: str,
        leaf_name: str,
        source: str,
        abi: str,
        free_threaded: bool,
        functions: list[ExportedFunctionIR],
    ) -> None:
        self.schema_version = schema_version
        self.compiler_name = compiler_name
        self.compiler_version = compiler_version
        self.compiler_commit = compiler_commit
        self.module_name = module_name
        self.leaf_name = leaf_name
        self.source = source
        self.abi = abi
        self.free_threaded = free_threaded
        self.functions = functions


def _is_alpha_or_underscore(b: int) -> bool:
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95


def _is_alnum_or_underscore(b: int) -> bool:
    return _is_alpha_or_underscore(b) or (b >= 48 and b <= 57)


def is_valid_ident(s: str) -> bool:
    """Return True if s matches ^[A-Za-z_][A-Za-z0-9_]*$."""
    n: int = nox.strings.byte_len(s)
    if n == 0:
        return False
    if not _is_alpha_or_underscore(nox.strings.byte_at(s, 0)):
        return False
    i: int = 1
    while i < n:
        if not _is_alnum_or_underscore(nox.strings.byte_at(s, i)):
            return False
        i += 1
    return True


def is_reserved_export_name(name: str) -> bool:
    """Return True for reserved dunder or CPython export symbol prefixes."""
    if (
        name == "__init__"
        or name == "__new__"
        or name == "__del__"
        or name == "__dict__"
        or name == "__name__"
        or name == "__doc__"
        or name == "__package__"
        or name == "__loader__"
        or name == "__spec__"
    ):
        return True
    if nox.strings.starts_with(name, "PyModExport_") or nox.strings.starts_with(name, "PyInit_"):
        return True
    return False


def is_c_keyword(name: str) -> bool:
    """Return True if name collides with a C11 reserved keyword."""
    keywords: dict[str, bool] = {
        "auto": True,
        "break": True,
        "case": True,
        "char": True,
        "const": True,
        "continue": True,
        "default": True,
        "do": True,
        "double": True,
        "else": True,
        "enum": True,
        "extern": True,
        "float": True,
        "for": True,
        "goto": True,
        "if": True,
        "inline": True,
        "int": True,
        "long": True,
        "register": True,
        "restrict": True,
        "return": True,
        "short": True,
        "signed": True,
        "sizeof": True,
        "static": True,
        "struct": True,
        "switch": True,
        "typedef": True,
        "union": True,
        "unsigned": True,
        "void": True,
        "volatile": True,
        "while": True,
        "_Atomic": True,
        "_Bool": True,
        "_Complex": True,
    }
    return name in keywords


def is_phase1_param_type(t: str) -> bool:
    return t == "int" or t == "float" or t == "bool" or t == "str" or t == "bytes"


def is_phase1_return_type(t: str) -> bool:
    return is_phase1_param_type(t) or t == "None"


def _slice_bytes(s: str, start: int, end: int) -> str:
    parts: list[str] = []
    i: int = start
    while i < end:
        parts.append(nox.strings.char_from_byte(nox.strings.byte_at(s, i)))
        i += 1
    return nox.strings.join(parts, "")


def _trim_ascii(s: str) -> str:
    n: int = nox.strings.byte_len(s)
    lo: int = 0
    while lo < n and (nox.strings.byte_at(s, lo) == 32 or nox.strings.byte_at(s, lo) == 9):
        lo += 1
    hi: int = n
    while hi > lo and (nox.strings.byte_at(s, hi - 1) == 32 or nox.strings.byte_at(s, hi - 1) == 9):
        hi -= 1
    return _slice_bytes(s, lo, hi)


def _split_top_level_commas(inner: str, context: str, file: str, line: int, col: int) -> list[str]:
    parts: list[str] = []
    n: int = nox.strings.byte_len(inner)
    depth: int = 0
    seg_start: int = 0
    i: int = 0
    while i < n:
        b: int = nox.strings.byte_at(inner, i)
        if b == 91:  # '['
            depth += 1
        elif b == 93:  # ']'
            if depth == 0:
                raise make_error("NPY-E-TYPE", "Unbalanced ']' in " + context, file, line, col, "")
            depth -= 1
        elif b == 44 and depth == 0:  # ','
            item: str = _trim_ascii(_slice_bytes(inner, seg_start, i))
            if item == "":
                raise make_error("NPY-E-TYPE", "Empty type element in " + context, file, line, col, "")
            parts.append(item)
            seg_start = i + 1
        i += 1
    if depth != 0:
        raise make_error("NPY-E-TYPE", "Unbalanced '[' in " + context, file, line, col, "")
    last_item: str = _trim_ascii(_slice_bytes(inner, seg_start, n))
    if last_item == "":
        raise make_error("NPY-E-TYPE", "Empty type element in " + context, file, line, col, "")
    parts.append(last_item)
    return parts


def _is_dict_key_type(t: str) -> bool:
    return t == "int" or t == "float" or t == "bool" or t == "str" or t == "bytes"


def _classify_type_impl(
    raw_t: str,
    depth: int,
    allow_none: bool,
    in_container: bool,
    file: str,
    line: int,
    col: int,
) -> str:
    if depth > MAX_TYPE_NEST_DEPTH:
        raise make_error("NPY-E-TYPE", "Type nesting depth exceeds limit (16): '" + raw_t + "'", file, line, col, "")
    t: str = _trim_ascii(raw_t)
    n: int = nox.strings.byte_len(t)
    if n == 0:
        raise make_error("NPY-E-TYPE", "Empty type name is not supported", file, line, col, "")

    if t == "None":
        if not allow_none:
            raise make_error("NPY-E-TYPE", "'None' is only supported as return type or 'T | None'", file, line, col, "")
        return "none"

    bdepth: int = 0
    pipe_idx: int = -1
    i: int = 0
    while i < n:
        b: int = nox.strings.byte_at(t, i)
        if b == 91:
            bdepth += 1
        elif b == 93:
            if bdepth == 0:
                raise make_error("NPY-E-TYPE", "Unbalanced ']' in type '" + t + "'", file, line, col, "")
            bdepth -= 1
        elif b == 124 and bdepth == 0:  # '|'
            if pipe_idx >= 0:
                raise make_error("NPY-E-TYPE", "Unsupported multi-union type '" + t + "'", file, line, col, "")
            pipe_idx = i
        i += 1
    if bdepth != 0:
        raise make_error("NPY-E-TYPE", "Unbalanced '[' in type '" + t + "'", file, line, col, "")

    if pipe_idx >= 0:
        lhs: str = _trim_ascii(_slice_bytes(t, 0, pipe_idx))
        rhs: str = _trim_ascii(_slice_bytes(t, pipe_idx + 1, n))
        if rhs != "None" or lhs == "" or lhs == "None":
            raise make_error("NPY-E-TYPE", "Only 'T | None' optional unions are supported, got '" + t + "'", file, line, col, "")
        if in_container and (lhs == "int" or lhs == "float" or lhs == "bool"):
            raise make_error(
                "NPY-E-TYPE",
                "Optional scalar '" + t + "' inside containers is not supported by upstream Host ABI",
                file,
                line,
                col,
                "",
            )
        # Validate inner non-None branch recursively; disallow nested Optional inside Optional.
        _classify_type_impl(lhs, depth + 1, False, in_container, file, line, col)
        if nox.strings.contains(lhs, "| None") and not nox.strings.starts_with(lhs, "list[") and not nox.strings.starts_with(lhs, "dict[") and not nox.strings.starts_with(lhs, "tuple["):
            raise make_error("NPY-E-TYPE", "Nested optional unions are not supported: '" + t + "'", file, line, col, "")
        return "value"

    if t == "int" or t == "float" or t == "bool":
        return "scalar"
    if t == "str" or t == "bytes":
        return "span"

    if nox.strings.starts_with(t, "list[") and nox.strings.ends_with(t, "]"):
        inner: str = _trim_ascii(_slice_bytes(t, 5, n - 1))
        if inner == "":
            raise make_error("NPY-E-TYPE", "Empty list element type in '" + t + "'", file, line, col, "")
        _classify_type_impl(inner, depth + 1, False, True, file, line, col)
        return "value"

    if nox.strings.starts_with(t, "dict[") and nox.strings.ends_with(t, "]"):
        inner_d: str = _trim_ascii(_slice_bytes(t, 5, n - 1))
        dparts: list[str] = _split_top_level_commas(inner_d, t, file, line, col)
        if len(dparts) != 2:
            raise make_error("NPY-E-TYPE", "dict must have exactly 2 type arguments: '" + t + "'", file, line, col, "")
        if not _is_dict_key_type(dparts[0]):
            raise make_error(
                "NPY-E-TYPE",
                "dict key type '" + dparts[0] + "' must be int, float, bool, str, or bytes in '" + t + "'",
                file,
                line,
                col,
                "",
            )
        _classify_type_impl(dparts[1], depth + 1, False, True, file, line, col)
        return "value"

    if nox.strings.starts_with(t, "tuple[") and nox.strings.ends_with(t, "]"):
        inner_t: str = _trim_ascii(_slice_bytes(t, 6, n - 1))
        if inner_t == "":
            raise make_error("NPY-E-TYPE", "Empty tuple[] is not supported", file, line, col, "")
        tparts: list[str] = _split_top_level_commas(inner_t, t, file, line, col)
        for ep in tparts:
            if ep == "...":
                raise make_error("NPY-E-TYPE", "Variadic tuple[...] is not supported: '" + t + "'", file, line, col, "")
            _classify_type_impl(ep, depth + 1, False, True, file, line, col)
        return "value"

    raise make_error("NPY-E-TYPE", "Unsupported type '" + t + "'", file, line, col, "")


def marshal_for_type(t: str, is_return: bool) -> str:
    """Return Host ABI marshal kind ('scalar'|'span'|'value'|'none') or raise NPY-E-TYPE."""
    return _classify_type_impl(t, 0, is_return, False, "", 0, 0)


def is_supported_param_type(t: str) -> bool:
    try:
        _classify_type_impl(t, 0, False, False, "", 0, 0)
        return True
    except NoxPyError:
        return False


def is_supported_return_type(t: str) -> bool:
    try:
        _classify_type_impl(t, 0, True, False, "", 0, 0)
        return True
    except NoxPyError:
        return False


def _is_lower_or_upper_hex(s: str) -> bool:
    n: int = nox.strings.byte_len(s)
    if (n % 2) != 0:
        return False
    i: int = 0
    while i < n:
        b: int = nox.strings.byte_at(s, i)
        ok: bool = (b >= 48 and b <= 57) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)
        if not ok:
            return False
        i += 1
    return True


def _ascii_lower(s: str) -> str:
    n: int = nox.strings.byte_len(s)
    parts: list[str] = []
    i: int = 0
    while i < n:
        b: int = nox.strings.byte_at(s, i)
        if b >= 65 and b <= 90:
            parts.append(nox.strings.char_from_byte(b + 32))
        else:
            parts.append(nox.strings.char_from_byte(b))
        i += 1
    return nox.strings.join(parts, "")


def _is_optional_default_compatible(ptype: str, def_ty: str) -> bool:
    if ptype == def_ty:
        return True
    if nox.strings.ends_with(ptype, " | None"):
        if def_ty == "None":
            return True
        inner: str = _slice_bytes(ptype, 0, nox.strings.byte_len(ptype) - 7)
        return inner == def_ty
    return False


def is_valid_param_kind(k: str) -> bool:
    return k == "positional_only" or k == "positional_or_keyword" or k == "keyword_only"


def is_valid_thread_policy(p: str) -> bool:
    return p == "parallel" or p == "instance_locked" or p == "thread_affine"


def _validate_ident(name: str, what: str, file: str, line: int, col: int) -> str:
    if not is_valid_ident(name):
        raise make_error("NPY-E-TYPE", "Invalid " + what + " identifier: '" + name + "'", file, line, col, "")
    if is_reserved_export_name(name):
        raise make_error("NPY-E-TYPE", "Reserved " + what + " name rejected: '" + name + "'", file, line, col, "")
    if is_c_keyword(name):
        raise make_error(
            "NPY-E-TYPE",
            "C reserved keyword cannot be exported as " + what + ": '" + name + "'",
            file,
            line,
            col,
            "",
        )
    return name


def _fn_less(a: ExportedFunctionIR, b: ExportedFunctionIR) -> bool:
    if a.name != b.name:
        return a.name < b.name
    return a.export_id < b.export_id


def _sort_functions(fns: list[ExportedFunctionIR]) -> list[ExportedFunctionIR]:
    """Deterministic ascending sort by (name, export_id)."""
    out: list[ExportedFunctionIR] = []
    for item in fns:
        out.append(item)
    i: int = 1
    while i < len(out):
        key: ExportedFunctionIR = out[i]
        j: int = i - 1
        while j >= 0 and _fn_less(key, out[j]):
            out[j + 1] = out[j]
            j -= 1
        out[j + 1] = key
        i += 1
    return out


def _pos_req_obj(doc: JsonValue, parent_pos: int, key: str, missing_msg: str) -> int:
    p: int = nox.json.pos_find(doc, parent_pos, key)
    if p < 0 or nox.json.pos_kind(doc, p) != 5:
        raise make_error("NPY-E-CODEGEN", missing_msg, "", 0, 0, "")
    return p


def _pos_opt_str(doc: JsonValue, parent_pos: int, key: str, default_val: str) -> str:
    p: int = nox.json.pos_find(doc, parent_pos, key)
    if p < 0 or nox.json.pos_kind(doc, p) == 0:
        return default_val
    if nox.json.pos_kind(doc, p) == 3:
        return nox.json.pos_str(doc, p)
    return default_val


def parse_upstream_metadata_json(
    raw_json: str,
    expected_module_name: str,
    abi: str,
    free_threaded: bool,
) -> ModuleIR:
    """Validate and lower compiler-owned UR-007 JSON metadata into a deterministic ModuleIR."""
    doc: JsonValue = nox.json.parse("{}")
    try:
        doc = nox.json.parse(raw_json)
    except JsonError as e:
        raise make_error("NPY-E-CODEGEN", "Invalid JSON metadata: " + e.message, "", 0, 0, "")

    if not nox.json.is_object(doc):
        raise make_error("NPY-E-CODEGEN", "Metadata root must be a JSON object", "", 0, 0, "")

    root: int = nox.json.pos_root(doc)

    schema_pos: int = nox.json.pos_find(doc, root, "schema_version")
    if schema_pos < 0 or nox.json.pos_kind(doc, schema_pos) != 2:
        raise make_error(
            "NPY-E-CODEGEN",
            "Unsupported or missing IR metadata schema_version (expected " + str(IR_SCHEMA_VERSION) + ")",
            "",
            0,
            0,
            "",
        )
    schema_ver: int = 0
    try:
        schema_ver = nox.json.pos_int(doc, schema_pos)
    except JsonError:
        raise make_error(
            "NPY-E-CODEGEN",
            "IR metadata schema_version must be integer " + str(IR_SCHEMA_VERSION),
            "",
            0,
            0,
            "",
        )
    if schema_ver != IR_SCHEMA_VERSION:
        raise make_error(
            "NPY-E-CODEGEN",
            "Unsupported IR metadata schema_version: " + str(schema_ver) + " (expected " + str(IR_SCHEMA_VERSION) + ")",
            "",
            0,
            0,
            "",
        )

    comp_pos: int = _pos_req_obj(doc, root, "compiler", "Missing 'compiler' block in metadata")
    comp_name: str = _pos_opt_str(doc, comp_pos, "name", "")
    comp_ver: str = _pos_opt_str(doc, comp_pos, "version", "")
    comp_commit: str = _pos_opt_str(doc, comp_pos, "commit", "")
    if comp_name != "noxc" or comp_ver == "":
        raise make_error("NPY-E-CODEGEN", "Invalid compiler identity in metadata (expected name='noxc' and non-empty version)", "", 0, 0, "")

    mod_pos: int = _pos_req_obj(doc, root, "module", "Missing 'module' block in metadata")
    mod_name: str = _pos_opt_str(doc, mod_pos, "name", "")
    mod_src: str = _pos_opt_str(doc, mod_pos, "source", "")
    if mod_name == "":
        raise make_error("NPY-E-CONFIG", "Invalid module name in metadata: ''", "", 0, 0, "")
    mod_parts: list[str] = nox.strings.split(mod_name, ".")
    for part in mod_parts:
        if not is_valid_ident(part):
            raise make_error("NPY-E-CONFIG", "Invalid module name in metadata: '" + mod_name + "'", "", 0, 0, "")
    if expected_module_name != "" and mod_name != expected_module_name:
        raise make_error(
            "NPY-E-CONFIG",
            "Metadata module '" + mod_name + "' does not match pyproject module-name '" + expected_module_name + "'",
            "",
            0,
            0,
            "",
        )
    leaf_name: str = mod_parts[len(mod_parts) - 1]

    exports_pos: int = nox.json.pos_find(doc, root, "exports")
    if exports_pos < 0 or nox.json.pos_kind(doc, exports_pos) != 4:
        raise make_error("NPY-E-CODEGEN", "Missing 'exports' list in metadata", "", 0, 0, "")

    seen_names: dict[str, bool] = {}
    seen_ids: dict[str, bool] = {}
    seen_syms: dict[str, bool] = {}
    functions: list[ExportedFunctionIR] = []

    export_count: int = nox.json.pos_len(doc, exports_pos)
    idx: int = 0
    while idx < export_count:
        entry_pos: int = nox.json.pos_at(doc, exports_pos, idx)
        if nox.json.pos_kind(doc, entry_pos) != 5:
            raise make_error("NPY-E-CODEGEN", "Export entry #" + str(idx) + " must be an object", "", 0, 0, "")

        span_pos: int = nox.json.pos_find(doc, entry_pos, "span")
        if span_pos < 0 or nox.json.pos_kind(doc, span_pos) != 5:
            raise make_error("NPY-E-CODEGEN", "Export entry #" + str(idx) + " missing 'span'", "", 0, 0, "")

        s_file: str = _pos_opt_str(doc, span_pos, "file", "")
        if s_file == "":
            s_file = mod_src if mod_src != "" else "<unknown>"

        s_line: int = 0
        line_pos: int = nox.json.pos_find(doc, span_pos, "line")
        if line_pos >= 0 and nox.json.pos_kind(doc, line_pos) == 2:
            try:
                s_line = nox.json.pos_int(doc, line_pos)
            except JsonError:
                s_line = 0

        s_col: int = 1
        col_pos: int = nox.json.pos_find(doc, span_pos, "column")
        if col_pos >= 0 and nox.json.pos_kind(doc, col_pos) == 2:
            try:
                c_tmp: int = nox.json.pos_int(doc, col_pos)
                if c_tmp != 0:
                    s_col = c_tmp
            except JsonError:
                s_col = 1

        span: SourceSpan = SourceSpan(s_file, s_line, s_col)

        kind_pos: int = nox.json.pos_find(doc, entry_pos, "kind")
        if kind_pos < 0 or nox.json.pos_kind(doc, kind_pos) != 3:
            raise make_error(
                "NPY-E-TYPE",
                "Unsupported export kind in Phase 1 IR (only 'function' supported)",
                s_file,
                s_line,
                s_col,
                "",
            )
        kind_val: str = nox.json.pos_str(doc, kind_pos)
        if kind_val != "function":
            raise make_error(
                "NPY-E-TYPE",
                "Unsupported export kind '" + kind_val + "' in Phase 1 IR (only 'function' supported)",
                s_file,
                s_line,
                s_col,
                "",
            )

        name_pos: int = nox.json.pos_find(doc, entry_pos, "name")
        if name_pos < 0 or nox.json.pos_kind(doc, name_pos) != 3:
            raise make_error("NPY-E-TYPE", "Invalid function identifier (expected string)", s_file, s_line, s_col, "")
        fn_name: str = _validate_ident(nox.json.pos_str(doc, name_pos), "function", s_file, s_line, s_col)
        if fn_name in seen_names:
            raise make_error("NPY-E-TYPE", "Duplicate exported function name: '" + fn_name + "'", s_file, s_line, s_col, "")
        seen_names[fn_name] = True

        id_pos: int = nox.json.pos_find(doc, entry_pos, "id")
        if id_pos < 0 or nox.json.pos_kind(doc, id_pos) != 3:
            raise make_error("NPY-E-CODEGEN", "Export '" + fn_name + "' missing unique stable 'id'", s_file, s_line, s_col, "")
        export_id: str = nox.json.pos_str(doc, id_pos)
        if export_id == "":
            raise make_error("NPY-E-CODEGEN", "Export '" + fn_name + "' missing unique stable 'id'", s_file, s_line, s_col, "")
        if export_id in seen_ids:
            raise make_error("NPY-E-CODEGEN", "Duplicate export id: '" + export_id + "'", s_file, s_line, s_col, "")
        seen_ids[export_id] = True

        csym_pos: int = nox.json.pos_find(doc, entry_pos, "c_symbol")
        if csym_pos < 0 or nox.json.pos_kind(doc, csym_pos) != 3:
            raise make_error("NPY-E-CODEGEN", "Invalid C export symbol for '" + fn_name + "'", s_file, s_line, s_col, "")
        c_symbol: str = nox.json.pos_str(doc, csym_pos)
        if not is_valid_ident(c_symbol):
            raise make_error("NPY-E-CODEGEN", "Invalid C export symbol for '" + fn_name + "': '" + c_symbol + "'", s_file, s_line, s_col, "")
        if c_symbol in seen_syms:
            raise make_error("NPY-E-CODEGEN", "Duplicate C symbol: '" + c_symbol + "'", s_file, s_line, s_col, "")
        seen_syms[c_symbol] = True

        thread_policy: str = "parallel"
        tp_pos: int = nox.json.pos_find(doc, entry_pos, "thread_policy")
        if tp_pos >= 0:
            if nox.json.pos_kind(doc, tp_pos) != 3:
                raise make_error("NPY-E-TYPE", "Unsupported thread_policy on '" + fn_name + "'", s_file, s_line, s_col, "")
            thread_policy = nox.json.pos_str(doc, tp_pos)
            if not is_valid_thread_policy(thread_policy):
                raise make_error(
                    "NPY-E-TYPE",
                    "Unsupported thread_policy '" + thread_policy + "' on '" + fn_name + "'",
                    s_file,
                    s_line,
                    s_col,
                    "",
                )

        ret_pos: int = nox.json.pos_find(doc, entry_pos, "return_type")
        if ret_pos < 0 or nox.json.pos_kind(doc, ret_pos) != 3:
            raise make_error("NPY-E-TYPE", "Unsupported return type on '" + fn_name + "'", s_file, s_line, s_col, "")
        ret_ty: str = _trim_ascii(nox.json.pos_str(doc, ret_pos))
        ret_marshal: str = _classify_type_impl(ret_ty, 0, True, False, s_file, s_line, s_col)

        rm_pos: int = nox.json.pos_find(doc, entry_pos, "return_marshal")
        if rm_pos >= 0:
            if nox.json.pos_kind(doc, rm_pos) != 3:
                raise make_error("NPY-E-TYPE", "Invalid return_marshal on '" + fn_name + "'", s_file, s_line, s_col, "")
            rm_val: str = nox.json.pos_str(doc, rm_pos)
            if rm_val != ret_marshal:
                raise make_error(
                    "NPY-E-TYPE",
                    "Return marshal mismatch for '" + fn_name + "': got '" + rm_val + "', expected '" + ret_marshal + "'",
                    s_file,
                    s_line,
                    s_col,
                    "",
                )

        params_pos: int = nox.json.pos_find(doc, entry_pos, "params")
        if params_pos < 0 or nox.json.pos_kind(doc, params_pos) != 4:
            raise make_error("NPY-E-CODEGEN", "Export '" + fn_name + "' missing 'params' list", s_file, s_line, s_col, "")

        params: list[ParamIR] = []
        seen_pnames: dict[str, bool] = {}
        seen_kw_only: bool = False
        seen_pos_default: bool = False
        param_count: int = nox.json.pos_len(doc, params_pos)
        pidx: int = 0
        while pidx < param_count:
            p_pos: int = nox.json.pos_at(doc, params_pos, pidx)
            if nox.json.pos_kind(doc, p_pos) != 5:
                raise make_error("NPY-E-CODEGEN", "Invalid param entry on '" + fn_name + "'", s_file, s_line, s_col, "")

            pname_pos: int = nox.json.pos_find(doc, p_pos, "name")
            if pname_pos < 0 or nox.json.pos_kind(doc, pname_pos) != 3:
                raise make_error("NPY-E-TYPE", "Invalid parameter identifier on '" + fn_name + "'", s_file, s_line, s_col, "")
            pname: str = _validate_ident(nox.json.pos_str(doc, pname_pos), "parameter", s_file, s_line, s_col)
            if pname in seen_pnames:
                raise make_error("NPY-E-TYPE", "Duplicate parameter '" + pname + "' on '" + fn_name + "'", s_file, s_line, s_col, "")
            seen_pnames[pname] = True

            ptype_pos: int = nox.json.pos_find(doc, p_pos, "type")
            if ptype_pos < 0 or nox.json.pos_kind(doc, ptype_pos) != 3:
                raise make_error("NPY-E-TYPE", "Unsupported parameter type for " + fn_name + "." + pname, s_file, s_line, s_col, "")
            ptype: str = _trim_ascii(nox.json.pos_str(doc, ptype_pos))
            pmarshal: str = _classify_type_impl(ptype, 0, False, False, s_file, s_line, s_col)

            pm_pos: int = nox.json.pos_find(doc, p_pos, "marshal")
            if pm_pos >= 0:
                if nox.json.pos_kind(doc, pm_pos) != 3:
                    raise make_error("NPY-E-TYPE", "Invalid marshal for " + fn_name + "." + pname, s_file, s_line, s_col, "")
                pm_val: str = nox.json.pos_str(doc, pm_pos)
                if pm_val != pmarshal:
                    raise make_error(
                        "NPY-E-TYPE",
                        "Parameter marshal mismatch for " + fn_name + "." + pname + ": got '" + pm_val + "', expected '" + pmarshal + "'",
                        s_file,
                        s_line,
                        s_col,
                        "",
                    )

            pkind: str = "positional_or_keyword"
            pk_pos: int = nox.json.pos_find(doc, p_pos, "kind")
            if pk_pos >= 0:
                if nox.json.pos_kind(doc, pk_pos) != 3:
                    raise make_error("NPY-E-TYPE", "Unsupported parameter kind for " + fn_name + "." + pname, s_file, s_line, s_col, "")
                pkind = nox.json.pos_str(doc, pk_pos)
                if not is_valid_param_kind(pkind):
                    raise make_error(
                        "NPY-E-TYPE",
                        "Unsupported parameter kind '" + pkind + "' for " + fn_name + "." + pname,
                        s_file,
                        s_line,
                        s_col,
                        "",
                    )

            if pkind == "positional_only" and seen_kw_only:
                raise make_error("NPY-E-TYPE", "Invalid parameter order in '" + fn_name + "'", s_file, s_line, s_col, "")
            if pkind == "keyword_only":
                seen_kw_only = True

            has_default: bool = False
            hd_pos: int = nox.json.pos_find(doc, p_pos, "has_default")
            if hd_pos >= 0:
                hd_kind: int = nox.json.pos_kind(doc, hd_pos)
                if hd_kind == 1:
                    has_default = nox.json.pos_bool(doc, hd_pos)
                elif hd_kind == 2:
                    has_default = nox.json.pos_number(doc, hd_pos) != 0.0
                elif hd_kind == 3:
                    has_default = nox.json.pos_str(doc, hd_pos) != ""

            if pkind != "keyword_only":
                if has_default:
                    seen_pos_default = True
                elif seen_pos_default:
                    raise make_error(
                        "NPY-E-TYPE",
                        "Non-default parameter '" + pname + "' cannot follow parameter with default value in '" + fn_name + "'",
                        s_file,
                        s_line,
                        s_col,
                        "",
                    )

            def_ty: str = ""
            def_int: int = 0
            def_float: float = 0.0
            def_bool: bool = False
            def_str: str = ""
            if has_default:
                def_pos: int = nox.json.pos_find(doc, p_pos, "default")
                if def_pos < 0 or nox.json.pos_kind(doc, def_pos) != 5:
                    raise make_error(
                        "NPY-E-TYPE",
                        "Missing or non-constant default value metadata for " + fn_name + "." + pname,
                        s_file,
                        s_line,
                        s_col,
                        "",
                    )
                dt_pos: int = nox.json.pos_find(doc, def_pos, "type")
                if dt_pos < 0 or nox.json.pos_kind(doc, dt_pos) != 3:
                    raise make_error(
                        "NPY-E-TYPE",
                        "Missing default value type for " + fn_name + "." + pname,
                        s_file,
                        s_line,
                        s_col,
                        "",
                    )
                def_ty = nox.json.pos_str(doc, dt_pos)
                if not _is_optional_default_compatible(ptype, def_ty):
                    raise make_error(
                        "NPY-E-TYPE",
                        "Default value type '" + def_ty + "' incompatible with parameter type '" + ptype + "' on " + fn_name + "." + pname,
                        s_file,
                        s_line,
                        s_col,
                        "",
                    )
                if def_ty == "None":
                    dv_pos: int = nox.json.pos_find(doc, def_pos, "value")
                    if dv_pos >= 0 and nox.json.pos_kind(doc, dv_pos) != 0:
                        raise make_error("NPY-E-TYPE", "None default value must be null on " + fn_name + "." + pname, s_file, s_line, s_col, "")
                elif def_ty == "bool":
                    dv_pos2: int = nox.json.pos_find(doc, def_pos, "value")
                    if dv_pos2 < 0 or nox.json.pos_kind(doc, dv_pos2) != 1:
                        raise make_error("NPY-E-TYPE", "bool default value must be JSON bool on " + fn_name + "." + pname, s_file, s_line, s_col, "")
                    def_bool = nox.json.pos_bool(doc, dv_pos2)
                elif def_ty == "int":
                    dv_pos3: int = nox.json.pos_find(doc, def_pos, "value")
                    if dv_pos3 < 0 or nox.json.pos_kind(doc, dv_pos3) != 2:
                        raise make_error("NPY-E-TYPE", "int default value must be JSON int on " + fn_name + "." + pname, s_file, s_line, s_col, "")
                    try:
                        def_int = nox.json.pos_int(doc, dv_pos3)
                    except JsonError:
                        raise make_error("NPY-E-TYPE", "int default out of int64 range on " + fn_name + "." + pname, s_file, s_line, s_col, "")
                elif def_ty == "float":
                    dv_pos4: int = nox.json.pos_find(doc, def_pos, "value")
                    if dv_pos4 < 0 or nox.json.pos_kind(doc, dv_pos4) != 2:
                        raise make_error("NPY-E-TYPE", "float default value must be JSON number on " + fn_name + "." + pname, s_file, s_line, s_col, "")
                    def_float = nox.json.pos_number(doc, dv_pos4)
                    if (def_float - def_float) != 0.0:
                        raise make_error("NPY-E-TYPE", "Non-finite float default not allowed on " + fn_name + "." + pname, s_file, s_line, s_col, "")
                elif def_ty == "str":
                    dv_pos5: int = nox.json.pos_find(doc, def_pos, "value")
                    if dv_pos5 < 0 or nox.json.pos_kind(doc, dv_pos5) != 3:
                        raise make_error("NPY-E-TYPE", "str default value must be JSON string on " + fn_name + "." + pname, s_file, s_line, s_col, "")
                    def_str = nox.json.pos_str(doc, dv_pos5)
                elif def_ty == "bytes":
                    hx_pos: int = nox.json.pos_find(doc, def_pos, "hex")
                    if hx_pos < 0 or nox.json.pos_kind(doc, hx_pos) != 3:
                        raise make_error("NPY-E-TYPE", "bytes default value must include 'hex' string on " + fn_name + "." + pname, s_file, s_line, s_col, "")
                    raw_hx: str = nox.json.pos_str(doc, hx_pos)
                    if not _is_lower_or_upper_hex(raw_hx):
                        raise make_error("NPY-E-TYPE", "Invalid hex string for bytes default on " + fn_name + "." + pname, s_file, s_line, s_col, "")
                    def_str = _ascii_lower(raw_hx)
                else:
                    raise make_error("NPY-E-TYPE", "Unsupported default value type '" + def_ty + "' on " + fn_name + "." + pname, s_file, s_line, s_col, "")

            params.append(ParamIR(pname, ptype, pmarshal, pkind, has_default, def_ty, def_int, def_float, def_bool, def_str))
            pidx += 1

        doc_str: str = ""
        has_doc: bool = False
        doc_pos: int = nox.json.pos_find(doc, entry_pos, "doc")
        if doc_pos >= 0:
            dk: int = nox.json.pos_kind(doc, doc_pos)
            if dk == 0:
                has_doc = False
            elif dk == 3:
                doc_str = nox.json.pos_str(doc, doc_pos)
                has_doc = True
            else:
                raise make_error("NPY-E-CODEGEN", "Docstring for '" + fn_name + "' must be string or null", s_file, s_line, s_col, "")

        functions.append(
            ExportedFunctionIR(
                export_id,
                fn_name,
                c_symbol,
                params,
                ret_ty,
                ret_marshal,
                doc_str,
                has_doc,
                thread_policy,
                span,
            )
        )
        idx += 1

    sorted_fns: list[ExportedFunctionIR] = _sort_functions(functions)
    return ModuleIR(
        IR_SCHEMA_VERSION,
        comp_name,
        comp_ver,
        comp_commit,
        mod_name,
        leaf_name,
        mod_src,
        abi,
        free_threaded,
        sorted_fns,
    )


def module_ir_to_json(ir: ModuleIR) -> str:
    """Serialize validated ModuleIR summary to compact JSON."""
    w: JsonWriter = JsonWriter()
    w.begin_object()
    w.write_key("schema_version")
    w.write_int(ir.schema_version)
    w.write_key("compiler_name")
    w.write_string(ir.compiler_name)
    w.write_key("compiler_version")
    w.write_string(ir.compiler_version)
    w.write_key("compiler_commit")
    w.write_string(ir.compiler_commit)
    w.write_key("module_name")
    w.write_string(ir.module_name)
    w.write_key("leaf_name")
    w.write_string(ir.leaf_name)
    w.write_key("source")
    w.write_string(ir.source)
    w.write_key("abi")
    w.write_string(ir.abi)
    w.write_key("free_threaded")
    w.write_bool(ir.free_threaded)
    w.write_key("export_count")
    w.write_int(len(ir.functions))
    w.write_key("exports")
    w.begin_array()
    for fn in ir.functions:
        w.begin_object()
        w.write_key("id")
        w.write_string(fn.export_id)
        w.write_key("name")
        w.write_string(fn.name)
        w.write_key("c_symbol")
        w.write_string(fn.c_symbol)
        w.write_key("return_type")
        w.write_string(fn.return_type)
        w.write_key("return_marshal")
        w.write_string(fn.return_marshal)
        w.write_key("thread_policy")
        w.write_string(fn.thread_policy)
        w.write_key("arity")
        w.write_int(len(fn.params))
        w.end_object()
    w.end_array()
    w.end_object()
    return w.build()
